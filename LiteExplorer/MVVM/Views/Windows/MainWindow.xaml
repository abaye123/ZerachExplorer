<Window x:Class="LiteExplorer.MVVM.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:LiteExplorer.MVVM.Views.UserControls"
        x:Name="Root"
        Width="1180"
        Height="740"
        MinWidth="820"
        MinHeight="500"
        Title="{Binding CurrentTab.TabTitle, StringFormat='{}{0} - זרח אקספלורר', TargetNullValue='זרח אקספלורר', FallbackValue='זרח אקספלורר'}"
        Icon="../../../Assets/app.ico"
        FontFamily="{StaticResource AppFont}"
        FontSize="14"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource TitleBarBrush}"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Q" Modifiers="Ctrl" Command="{Binding CloseAppCmd}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding AddTabCmd}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCmd}" CommandParameter="{Binding CurrentTab}" />
    </Window.InputBindings>

    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- A maximized window with a resize frame extends past the screen edges -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding WindowState, ElementName=Root}" Value="Maximized" />
                            <Condition Binding="{Binding WindowStyle, ElementName=Root}" Value="SingleBorderWindow" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Margin" Value="7" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding CurrentTab}"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Source="../../../Assets/app.ico" Width="18" Height="18" Margin="14,0,8,0" Style="{StaticResource SharpImage}" />

                            <DockPanel Grid.Column="1" LastChildFill="False" Margin="0,0,40,0">
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ScrollViewer>
                                <Button Content="&#xE710;"
                                        Style="{StaticResource IconButton}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Width="36"
                                        MinHeight="32"
                                        FontSize="12"
                                        Margin="6,0"
                                        Command="{Binding AddTabCmd}"
                                        ToolTip="כרטיסייה חדשה (Ctrl+T)" />
                            </DockPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResizeMode, ElementName=Root}" Value="NoResize">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="מזער" />
                                    <Button Click="Maximize_Click" ToolTip="הגדל / שחזר">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                                <Setter Property="Content" Value="&#xE922;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WindowState, ElementName=Root}" Value="Maximized">
                                                        <Setter Property="Content" Value="&#xE923;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Command="{Binding CloseAppCmd}" ToolTip="סגור" />
                            </StackPanel>
                        </Grid>

                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=Root}" />
                    <EventSetter Event="PreviewMouseDown" Handler="Tab_PreviewMouseDown" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu Style="{StaticResource MenuPanel}" DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="סגור כרטיסייה" Icon="&#xE711;" InputGestureText="Ctrl+W" Command="{Binding Tag.CloseTabCmd}" CommandParameter="{Binding DataContext}" />
                                <MenuItem Header="סגור כרטיסיות אחרות" Command="{Binding Tag.CloseOtherTabsCmd}" CommandParameter="{Binding DataContext}" />
                                <Separator />
                                <MenuItem Header="כרטיסייה חדשה" Icon="&#xE710;" InputGestureText="Ctrl+T" Command="{Binding Tag.AddTabCmd}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid Margin="0,7,0,0" Height="37">
                                    <Border x:Name="Back" Margin="2,0,2,4" Background="Transparent" CornerRadius="6" />
                                    <Border x:Name="Selected" Background="{StaticResource ToolbarBrush}" CornerRadius="8,8,0,0" Visibility="Collapsed" />
                                    <Border x:Name="Divider" Width="1" Height="16" HorizontalAlignment="Right" Background="#22000000" />
                                    <ContentPresenter Width="230" Margin="12,0,6,2" VerticalAlignment="Center" ContentSource="Header" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Back" Property="Background" Value="#66FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip="{Binding TabPath}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="LocationIcon" Source="{Binding TabIcon}" Width="16" Height="16" Style="{StaticResource SharpImage}" />
                        <TextBlock x:Name="HomeIcon" Text="&#xE80F;" Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        <TextBlock Grid.Column="1" Text="{Binding TabTitle}" Style="{StaticResource NameText}" FontSize="13" Margin="10,0" />
                        <Button Grid.Column="2"
                                Content="&#xE711;"
                                Style="{StaticResource IconButton}"
                                FontSize="10"
                                Width="28"
                                MinWidth="28"
                                MinHeight="28"
                                Command="{Binding DataContext.CloseTabCmd, ElementName=Root}"
                                CommandParameter="{Binding}"
                                ToolTip="סגור כרטיסייה (Ctrl+W)" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHome}" Value="True">
                            <Setter TargetName="LocationIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HomeIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <uc:TabContent />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Border>
</Window>
