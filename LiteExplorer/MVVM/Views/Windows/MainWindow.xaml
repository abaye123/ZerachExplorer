<ui:UiWindow x:Class="LiteExplorer.MVVM.Views.Windows.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:LiteExplorer.MVVM.Views.UserControls"
             xmlns:c="clr-namespace:LiteExplorer.Infrastructure.Converters" 
             xmlns:vm="clr-namespace:LiteExplorer.MVVM.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             Width="1120"
             Height="680"
             MinWidth="760"
             MinHeight="480"
             Title="{Binding CurrentTab.TabTitle, TargetNullValue='בית'}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Background="#F0F4F9"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="Mica"
             WindowCornerPreference="Round"
             FlowDirection="RightToLeft"
             WindowStartupLocation="CenterScreen">

    <ui:UiWindow.Resources>
        <c:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
    </ui:UiWindow.Resources>

    <ui:UiWindow.InputBindings>
        <KeyBinding Key="Q"
                    Command="{Binding CloseAppCmd}"
                    Modifiers="Ctrl" />
        <KeyBinding Key="T"
                    Command="{Binding AddTabCmd}"
                    Modifiers="Ctrl" />
        <KeyBinding Key="W"
                    Command="{Binding CloseTabCmd}"
                    CommandParameter="{Binding CurrentTab}"
                    Modifiers="Ctrl" />
    </ui:UiWindow.InputBindings>

    <DockPanel Background="#F0F4F9">
        <!-- Window Title Bar -->
        <ui:TitleBar Title="{Binding MainWindowTitle}"
                     Height="32"
                     Padding="10,4,10,0"
                     DockPanel.Dock="Top"
                     Icon="/Assets/app.ico"
                     UseSnapLayout="True" />

        <!-- Windows 11 Style Status Bar -->
        <Border DockPanel.Dock="Bottom"
                DataContext="{Binding CurrentTab}"
                Background="#F7F9FC"
                BorderBrush="#E5E8EC"
                BorderThickness="0,1,0,0"
                Height="26"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#5C5C5C"
                           FontSize="12"
                           Text="{Binding FileSystemObjects.Count, StringFormat='{}{0} פריטים'}" />

                <Border Grid.Column="1"
                        Width="1"
                        Height="12"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Background="#DCDFE4"
                        Visibility="{Binding CurrentFileSystemObject.Path, Converter={StaticResource NonEmptyStringToVisibilityConverter}, FallbackValue=Collapsed}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="#5C5C5C"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding CurrentFileSystemObject.Path, StringFormat='נבחר: {0}'}" />

                <ProgressBar Grid.Column="3"
                             Width="140"
                             Height="4"
                             VerticalAlignment="Center"
                             Value="{Binding ProgressPercent}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar"
                               BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource Self}}"
                                             Value="100">
                                    <Setter Property="Visibility"
                                            Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>

        <!-- Windows 11 Explorer Tab Control -->
        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding CurrentTab}"
                    Background="#FFFFFF"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Resources>
                <c:BoolToVisibility x:Key="BoolToVisibilityConverter" />
            </TabControl.Resources>
            <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Tab Strip -->
                        <Border Grid.Row="0"
                                Background="#EBF0F5"
                                Padding="8,4,8,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TabPanel x:Name="HeaderPanel"
                                              Panel.ZIndex="1"
                                              Background="Transparent"
                                              IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1" />
                                    <ui:Button Margin="4,0,4,4"
                                               Width="28"
                                               Height="28"
                                               MinWidth="0"
                                               MinHeight="0"
                                               Padding="0"
                                               Command="{Binding AddTabCmd}"
                                               Icon="Add16"
                                               Foreground="#333333"
                                               BorderBrush="Transparent"
                                               Background="Transparent"
                                               ToolTip="פתח כרטיסיה חדשה (Ctrl+T)" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Tab Content -->
                        <Border x:Name="Border"
                                Grid.Row="1"
                                Background="#FFFFFF"
                                BorderThickness="0"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#333333" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="TabBorder"
                                        MinWidth="160"
                                        MaxWidth="240"
                                        Height="34"
                                        Margin="2,0"
                                        Padding="12,0,8,0"
                                        Background="Transparent"
                                        CornerRadius="8,8,0,0">
                                    <ContentPresenter x:Name="ContentSite"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#E0E6EE" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="100" />
                                        <Setter TargetName="TabBorder" Property="Background" Value="#F7F9FC" />
                                        <Setter Property="Foreground" Value="#1A1A1A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Folder20"
                                       FontSize="15"
                                       Foreground="#E0A628"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   FlowDirection="RightToLeft"
                                   Foreground="#1A1A1A"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0"
                                   Text="{Binding TabTitle, TargetNullValue='בית'}" />
                        <ui:Button Grid.Column="2"
                                   Width="20"
                                   Height="20"
                                   MinWidth="0"
                                   MinHeight="0"
                                   Padding="0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Command="{Binding DataContext.CloseTabCmd, RelativeSource={RelativeSource AncestorType=ui:UiWindow}}"
                                   CommandParameter="{Binding}"
                                   Icon="Dismiss12"
                                   Foreground="#5C5C5C"
                                   Cursor="Hand"
                                   Focusable="False"
                                   ToolTip="סגור כרטיסיה (Ctrl+W)"
                                   BorderBrush="Transparent"
                                   Background="Transparent" />
                    </Grid>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <uc:TabContent />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</ui:UiWindow>
