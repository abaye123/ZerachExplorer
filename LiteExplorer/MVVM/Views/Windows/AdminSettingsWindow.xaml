<Window x:Class="LiteExplorer.MVVM.Views.Windows.AdminSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="הגדרות מדיניות עמדה (Admin)"
        Height="620"
        Width="740"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="0,0,0,12"
                Margin="0,0,0,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="ניהול מדיניות עמדה ומנהל מערכת"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="הגדר פרופילי פעולה, הרשאות קבצים, סיומות מותרות ותיקיות עבודה ייעודיות."
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Main Body Tabs / Sections -->
        <TabControl Grid.Row="1">
            <!-- Profile & Permissions Tab -->
            <TabItem Header="פרופיל והרשאות">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="פרופיל פעולה פעיל"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="בחר אחד מהפרופילים המובנים או התאם אישית."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,8" />

                                <ComboBox x:Name="CmbProfile"
                                          Width="300"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="CmbProfile_SelectionChanged">
                                    <ComboBoxItem Content="עמדת מסמכים סטנדרטית (ברירת מחדל)" Tag="Standard" />
                                    <ComboBoxItem Content="עמדת עיון (קריאה בלבד - Read-Only)" Tag="ReadOnly" />
                                    <ComboBoxItem Content="עמדת עבודה מבוקרת (Controlled)" Tag="Controlled" />
                                    <ComboBoxItem Content="התאמה אישית (Custom)" Tag="Custom" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="הרשאות פעולה (Path Permissions)"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="קבע את הפעולות המותרות בעמדה:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,10" />

                                <WrapPanel ItemWidth="200" Margin="0,5">
                                    <CheckBox x:Name="ChkCanList" Content="עיון וסריקת תיקיות (List)" Margin="0,5" />
                                    <CheckBox x:Name="ChkCanOpen" Content="פתיחת קבצים (Open)" Margin="0,5" />
                                    <CheckBox x:Name="ChkCanCopyFrom" Content="העתקת קבצים (CopyFrom)" Margin="0,5" />
                                    <CheckBox x:Name="ChkCanCopyTo" Content="הדבקה וכתיבה ליעד (CopyTo)" Margin="0,5" />
                                    <CheckBox x:Name="ChkCanRename" Content="שינוי שם קבצים (Rename)" Margin="0,5" />
                                    <CheckBox x:Name="ChkCanDelete" Content="מחיקת קבצים ותיקיות (Delete)" Margin="0,5" />
                                    <CheckBox x:Name="ChkCanCreateDir" Content="יצירת תיקיות חדשות (New Folder)" Margin="0,5" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Allowed Extensions Tab -->
            <TabItem Header="סיומות קבצים מותרות">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="סיומות קבצים מורשות לפתיחה והעתקה"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="קבצים שאינם מופיעים ברשימה זו ייחסמו לחלוטין."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListBox x:Name="LstExtensions"
                             Grid.Row="1"
                             Margin="0,0,0,10"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtNewExtension"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 Padding="6,4" />
                        <ui:Button Grid.Column="1"
                                   Content="הוסף סיומת"
                                   Margin="0,0,6,0"
                                   Click="AddExtension_Click" />
                        <ui:Button Grid.Column="2"
                                   Content="הסר נבחר"
                                   Margin="0,0,6,0"
                                   Click="RemoveExtension_Click" />
                        <ui:Button Grid.Column="3"
                                   Content="איפוס לברירת מחדל"
                                   Click="ResetExtensions_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Explicit Folders Tab -->
            <TabItem Header="תיקיות עבודה מאושרות">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="תיקיות מאושרות (Explicit Allowed Directories)"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="ספריות מקומיות המאושרות לגישה ישירה בעמדת עבודה מבוקרת:"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListBox x:Name="LstDirectories"
                             Grid.Row="1"
                             Margin="0,0,0,10"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtNewDirectory"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 Padding="6,4" />
                        <ui:Button Grid.Column="1"
                                   Content="הוסף תיקייה"
                                   Margin="0,0,6,0"
                                   Click="AddDirectory_Click" />
                        <ui:Button Grid.Column="2"
                                   Content="הסר נבחר"
                                   Click="RemoveDirectory_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Password Tab -->
            <TabItem Header="סיסמת מנהל">
                <StackPanel Margin="0,12,0,0" MaxWidth="400" HorizontalAlignment="Right">
                    <TextBlock Text="שינוי סיסמת מנהל"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="הזן סיסמה חדשה להגנה על מסך הניהול:"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,15" />

                    <TextBlock Text="סיסמה חדשה:" Margin="0,0,0,4" />
                    <PasswordBox x:Name="TxtNewPassword" Margin="0,0,0,10" Padding="6,4" />

                    <TextBlock Text="אימות סיסמה חדשה:" Margin="0,0,0,4" />
                    <PasswordBox x:Name="TxtConfirmPassword" Margin="0,0,0,15" Padding="6,4" />

                    <ui:Button Content="עדכן סיסמה"
                               HorizontalAlignment="Left"
                               Width="120"
                               Click="UpdatePassword_Click" />

                    <TextBlock x:Name="TxtPasswordStatus"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Visibility="Collapsed" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="0,12,0,0"
                Margin="0,10,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="שמור והחל שינויים"
                               Appearance="Primary"
                               Icon="Save24"
                               Width="160"
                               Margin="0,0,10,0"
                               Click="Save_Click" />
                    <ui:Button Content="ביטול"
                               Width="90"
                               IsCancel="True"
                               Click="Cancel_Click" />
                </StackPanel>
                <TextBlock x:Name="TxtStatusMessage"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
