<w:DialogWindow x:Class="LiteExplorer.MVVM.Views.Windows.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:LiteExplorer.MVVM.Views.Windows"
        Title=""
        Width="460"
        Glyph="&#xE8AC;">
    <w:DialogWindow.Footer>
        <StackPanel Orientation="Horizontal">
            <Button Content="שינוי שם" Style="{StaticResource DialogAccentButton}" Click="Accept_Click" IsDefault="True" />
            <Button Content="ביטול" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </w:DialogWindow.Footer>
    <StackPanel>
        <TextBlock x:Name="TxtPrompt" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="TxtValue" />
    </StackPanel>
</w:DialogWindow>
