<w:DialogWindow x:Class="LiteExplorer.MVVM.Views.Windows.AdminPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:LiteExplorer.MVVM.Views.Windows"
        Title="כניסת מנהל"
        Width="440"
        Glyph="&#xE72E;">
    <w:DialogWindow.Footer>
        <StackPanel Orientation="Horizontal">
            <Button Content="אישור" Style="{StaticResource DialogAccentButton}" Click="Confirm_Click" />
            <Button Content="ביטול" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </w:DialogWindow.Footer>
    <StackPanel>
        <TextBlock Text="הזן את סיסמת המנהל כדי להמשיך." Margin="0,0,0,10" TextWrapping="Wrap" />
        <PasswordBox x:Name="TxtPassword" KeyDown="TxtPassword_KeyDown" />
        <TextBlock x:Name="TxtError"
                   Foreground="{StaticResource ErrorBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</w:DialogWindow>
