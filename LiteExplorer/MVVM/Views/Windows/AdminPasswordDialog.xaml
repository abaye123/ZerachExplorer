<Window x:Class="LiteExplorer.MVVM.Views.Windows.AdminPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="אימות מנהל מערכת"
        Height="240"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="הזנת סיסמת מנהל"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <TextBlock Grid.Row="1"
                   Text="נדרשת סיסמת מנהל כדי לגשת להגדרות המדיניות והפרופילים."
                   FontSize="13"
                   Margin="0,5,0,15"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <PasswordBox x:Name="TxtPassword"
                     Grid.Row="2"
                     FontSize="14"
                     Padding="8,6"
                     KeyDown="TxtPassword_KeyDown" />

        <TextBlock x:Name="TxtError"
                   Grid.Row="3"
                   Foreground="#FFE03E3E"
                   FontSize="12"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,15,0,0">
            <ui:Button Content="אישור"
                       Icon="Checkmark24"
                       Appearance="Primary"
                       Width="100"
                       Margin="0,0,10,0"
                       Click="Confirm_Click" />
            <ui:Button Content="ביטול"
                       Width="90"
                       IsCancel="True"
                       Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
