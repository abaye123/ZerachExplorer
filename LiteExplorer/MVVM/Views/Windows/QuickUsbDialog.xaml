<w:DialogWindow x:Class="LiteExplorer.MVVM.Views.Windows.QuickUsbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:LiteExplorer.MVVM.Views.Windows"
        Title="כונן USB חובר"
        Width="440"
        Glyph="&#xE88E;">
    <w:DialogWindow.Footer>
        <StackPanel Orientation="Horizontal">
            <Button Content="פתיחת הכונן" Style="{StaticResource DialogAccentButton}" Click="OpenDrive_Click" IsDefault="True" />
            <Button Content="סגירה" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </w:DialogWindow.Footer>
    <TextBlock x:Name="TxtDriveInfo" TextWrapping="Wrap" LineHeight="22" />
</w:DialogWindow>
