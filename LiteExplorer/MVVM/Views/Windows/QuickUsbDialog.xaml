<Window x:Class="LiteExplorer.MVVM.Views.Windows.QuickUsbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="התקן USB חדש"
        Height="210"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ui:SymbolIcon Symbol="Usb24" FontSize="24" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="התקן USB זוהה בהצלחה"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="TxtDriveInfo"
                   Grid.Row="1"
                   Text="האם ברצונך לפתוח את תוכן ההתקן כעת?"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,15,0,0">
            <ui:Button Content="פתח כונן"
                       Icon="FolderOpen24"
                       Appearance="Primary"
                       Width="110"
                       Margin="0,0,10,0"
                       Click="OpenDrive_Click" />
            <ui:Button Content="סגור"
                       Appearance="Secondary"
                       Width="90"
                       Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
