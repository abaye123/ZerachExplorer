<Window x:Class="LiteExplorer.MVVM.Views.Windows.SetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="קביעת סיסמת מנהל"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtMessage"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />
        <TextBlock Text="סיסמה חדשה (לפחות 8 תווים):" Margin="0,0,0,4" />
        <PasswordBox x:Name="TxtPassword" Padding="8,6" Margin="0,0,0,10" />
        <TextBlock Text="אימות סיסמה:" Margin="0,0,0,4" />
        <PasswordBox x:Name="TxtConfirm" Padding="8,6" />
        <TextBlock x:Name="TxtError"
                   Foreground="#FFE03E3E"
                   TextWrapping="Wrap"
                   MinHeight="20"
                   Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <ui:Button Content="שמור"
                       Appearance="Primary"
                       IsDefault="True"
                       Width="100"
                       Margin="0,0,10,0"
                       Click="Save_Click" />
            <ui:Button Content="ביטול" Width="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
