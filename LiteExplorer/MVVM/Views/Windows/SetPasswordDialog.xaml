<w:DialogWindow x:Class="LiteExplorer.MVVM.Views.Windows.SetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:LiteExplorer.MVVM.Views.Windows"
        Title="קביעת סיסמת מנהל"
        Width="460"
        Glyph="&#xE72E;">
    <w:DialogWindow.Footer>
        <StackPanel Orientation="Horizontal">
            <Button Content="שמירה" Style="{StaticResource DialogAccentButton}" Click="Save_Click" IsDefault="True" />
            <Button Content="ביטול" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </w:DialogWindow.Footer>
    <StackPanel>
        <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" Margin="0,0,0,14" />
        <TextBlock Text="סיסמה חדשה (לפחות 8 תווים)" Margin="0,0,0,6" />
        <PasswordBox x:Name="TxtPassword" Margin="0,0,0,12" />
        <TextBlock Text="אימות סיסמה" Margin="0,0,0,6" />
        <PasswordBox x:Name="TxtConfirm" />
        <TextBlock x:Name="TxtError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" MinHeight="20" Margin="0,8,0,0" />
    </StackPanel>
</w:DialogWindow>
