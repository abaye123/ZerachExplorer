<UserControl x:Class="LiteExplorer.MVVM.Views.UserControls.TabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LiteExplorer.MVVM.ViewModels"
             xmlns:models="clr-namespace:LiteExplorer.MVVM.Models"
             xmlns:c="clr-namespace:LiteExplorer.Infrastructure.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             d:DataContext="{d:DesignInstance vm:TabContentViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Background="#FFFFFF">

    <UserControl.Resources>
        <c:BytesToNormalSize x:Key="BytesToNormalSizeConverter" />
        <c:BoolToVisibility x:Key="BoolToVisibilityConverter" />
        <c:InverseBoolToVisibility x:Key="InverseBoolToVisibilityConverter" />
        <c:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />

        <ContextMenu x:Key="ItemContextMenu" FlowDirection="RightToLeft">
            <MenuItem Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="פתח"
                      FontWeight="SemiBold" />
            <Separator />
            <MenuItem Command="{Binding DataContext.CutCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Header="גזור (Ctrl+X)" />
            <MenuItem Command="{Binding DataContext.CopyCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Header="העתק (Ctrl+C)" />
            <MenuItem Command="{Binding DataContext.PasteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Header="הדבק (Ctrl+V)" />
            <Separator />
            <MenuItem Command="{Binding DataContext.RenameCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="שינוי שם (F2)" />
            <MenuItem Command="{Binding DataContext.DeleteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="מחק (Delete)" />
            <MenuItem Command="{Binding DataContext.CreateDirectoryCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Header="תיקייה חדשה (Ctrl+Shift+N)" />
            <Separator Visibility="{Binding PlacementTarget.DataContext.IsRemovableDrive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <MenuItem Command="{Binding DataContext.EjectDriveCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding PlacementTarget.DataContext.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="הוצאה בטוחה"
                      Visibility="{Binding PlacementTarget.DataContext.IsRemovableDrive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Separator />
            <MenuItem Command="{Binding DataContext.CalculateFolderSizeCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="חשב גודל תיקייה" />
        </ContextMenu>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding CopyCmd}" Modifiers="Ctrl" Key="C" />
        <KeyBinding Command="{Binding CutCmd}" Modifiers="Ctrl" Key="X" />
        <KeyBinding Command="{Binding PasteCmd}" Modifiers="Ctrl" Key="V" />
        <KeyBinding Command="{Binding CreateDirectoryCmd}" Modifiers="Ctrl+Shift" Key="N" />
        <KeyBinding Command="{Binding DeleteCmd}" Key="Delete" />
        <KeyBinding Command="{Binding RenameCmd}" CommandParameter="{Binding CurrentFileSystemObject.Path}" Key="F2" />
        <KeyBinding Command="{Binding RefreshCmd}" Key="F5" />
        <KeyBinding Command="{Binding TogglePreviewPaneCmd}" Modifiers="Alt" Key="P" />
        <KeyBinding Command="{Binding ToggleViewModeCmd}" Modifiers="Ctrl+Shift" Key="V" />
        <KeyBinding Command="{Binding OpenAdminCmd}" Modifiers="Ctrl+Shift" Key="A" />
    </UserControl.InputBindings>

    <Grid FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Windows 11 Command Bar -->
        <Border Grid.Row="0"
                Background="#F7F9FC"
                BorderBrush="#E5E8EC"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Border.Resources>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="#1A1A1A" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Margin" Value="1,0" />
                    <Setter Property="Padding" Value="10,4" />
                    <Setter Property="FontSize" Value="12.5" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EAEFF5" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Margin" Value="6,0" />
                    <Setter Property="Background" Value="#DCE0E6" />
                </Style>
            </Border.Resources>

            <!-- Column 0 = Visual Right (Primary Actions), Column 1 = Visual Left (Utility/Settings) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:Button Command="{Binding CreateDirectoryCmd}"
                               Icon="FolderAdd20"
                               Content="חדש"
                               ToolTip="תיקייה חדשה (Ctrl+Shift+N)" />

                    <Separator />

                    <ui:Button Command="{Binding CutCmd}"
                               Icon="Cut20"
                               Width="34"
                               Padding="0"
                               ToolTip="גזור (Ctrl+X)" />

                    <ui:Button Command="{Binding CopyCmd}"
                               Icon="Copy20"
                               Width="34"
                               Padding="0"
                               ToolTip="העתק (Ctrl+C)" />

                    <ui:Button Command="{Binding PasteCmd}"
                               Icon="ClipboardPaste20"
                               Width="34"
                               Padding="0"
                               ToolTip="הדבק (Ctrl+V)" />

                    <ui:Button Command="{Binding RenameCmd}"
                               CommandParameter="{Binding CurrentFileSystemObject.Path}"
                               Icon="Rename20"
                               Width="34"
                               Padding="0"
                               ToolTip="שינוי שם (F2)" />

                    <ui:Button Command="{Binding DeleteCmd}"
                               CommandParameter="{Binding CurrentFileSystemObject.Path}"
                               Icon="Delete20"
                               Width="34"
                               Padding="0"
                               ToolTip="מחק (Delete)" />

                    <Separator />

                    <ui:Button Command="{Binding ToggleViewModeCmd}"
                               Icon="Grid20"
                               Content="תצוגה"
                               ToolTip="החלף תצוגת פרטים / אריחים (Ctrl+Shift+V)" />

                    <ui:Button Command="{Binding TogglePreviewPaneCmd}"
                               Icon="PanelRight20"
                               Content="פרטים ותצוגה"
                               ToolTip="הצג או הסתר חלונית תצוגה מקדימה (Alt+P)" />
                </StackPanel>

                <!-- Utility / Settings buttons on the visual LEFT -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Command="{Binding RefreshCmd}"
                               Icon="ArrowClockwise20"
                               Width="34"
                               Padding="0"
                               ToolTip="רענן (F5)" />
                    <ui:Button Command="{Binding OpenAdminCmd}"
                               Icon="Settings20"
                               Width="34"
                               Padding="0"
                               ToolTip="הגדרות מנהל מערכת (Ctrl+Shift+A)" />
                    <ui:Button Command="{Binding OpenAboutCmd}"
                               CommandParameter="{Binding TabPath}"
                               Icon="Info20"
                               Width="34"
                               Padding="0"
                               ToolTip="אודות" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Windows 11 Navigation, Address Bar & Search -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#EAECEF"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Command="{Binding BackHome}"
                           Icon="Home20"
                           Foreground="#333333"
                           BorderBrush="Transparent"
                           Background="Transparent"
                           Height="32"
                           Width="34"
                           Padding="0"
                           ToolTip="בית (כל הכוננים)" />

                <ui:Button Grid.Column="1"
                           Command="{Binding BackCmd}"
                           Icon="ArrowUp20"
                           Foreground="#333333"
                           BorderBrush="Transparent"
                           Background="Transparent"
                           Height="32"
                           Width="34"
                           Margin="2,0,6,0"
                           Padding="0"
                           ToolTip="למעלה (Backspace)" />

                <!-- Address Bar -->
                <Grid Grid.Column="2" Margin="0,0,8,0">
                    <!-- Breadcrumbs mode -->
                    <Border Visibility="{Binding IsAddressBarEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Background="#F4F6F9"
                            BorderBrush="#E2E5E9"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="34"
                            Padding="6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="FolderOpen20"
                                           FontSize="15"
                                           Foreground="#E0A628"
                                           Margin="4,0,6,0"
                                           VerticalAlignment="Center" />

                            <ScrollViewer Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.NavigateBreadcrumbCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Path}"
                                                        Content="{Binding Name}"
                                                        Foreground="#1A1A1A"
                                                        FontSize="12.5"
                                                        Padding="6,3"
                                                        Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="4"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#E4E8EE" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <ui:SymbolIcon Symbol="ChevronLeft12"
                                                               FontSize="11"
                                                               Foreground="#757575"
                                                               VerticalAlignment="Center"
                                                               Margin="1,1,1,0"
                                                               Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ui:Button Grid.Column="2"
                                       Command="{Binding ToggleAddressBarEditCmd}"
                                       Icon="Edit16"
                                       Foreground="#5C5C5C"
                                       Width="26"
                                       Height="26"
                                       MinWidth="0"
                                       MinHeight="0"
                                       Padding="0"
                                       Background="Transparent"
                                       BorderBrush="Transparent"
                                       ToolTip="ערוך נתיב כטקסט" />
                        </Grid>
                    </Border>

                    <!-- Text Edit mode -->
                    <Grid Visibility="{Binding IsAddressBarEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12.5"
                                 Foreground="#1A1A1A"
                                 Background="#FFFFFF"
                                 BorderBrush="#0067C0"
                                 BorderThickness="1"
                                 Text="{Binding TabPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Gesture="Enter"
                                            Command="{Binding OpenCmd}"
                                            CommandParameter="{Binding TabPath}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <ui:Button Grid.Column="1"
                                   Command="{Binding ToggleAddressBarEditCmd}"
                                   Icon="Checkmark16"
                                   Width="34"
                                   Height="34"
                                   Padding="0"
                                   Margin="4,0,0,0"
                                   ToolTip="סיום עריכת נתיב" />
                    </Grid>
                </Grid>

                <!-- Search Box -->
                <Border Grid.Column="3"
                        Width="230"
                        Height="34"
                        Background="#F4F6F9"
                        BorderBrush="#E2E5E9"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Search16"
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="חיפוש בתיקייה זו..."
                                       Foreground="#757575"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchInput"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Foreground="#1A1A1A"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center" />
                        </Grid>

                        <ui:Button Grid.Column="2"
                                   Command="{Binding ClearSearchCmd}"
                                   Icon="Dismiss12"
                                   Foreground="#5C5C5C"
                                   Width="22"
                                   Height="22"
                                   MinWidth="0"
                                   MinHeight="0"
                                   Padding="0"
                                   Background="Transparent"
                                   BorderBrush="Transparent"
                                   ToolTip="נקה חיפוש"
                                   Visibility="{Binding SearchText, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Row 2: Main Workspace (Sidebar + File List + Splitter + Preview) -->
        <Grid Grid.Row="2" Background="#FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="195" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Windows 11 Navigation Pane (Right side in RTL) -->
            <Border Grid.Column="0"
                    Background="#F7F9FC"
                    BorderBrush="#EAECEF"
                    BorderThickness="0,0,1,0"
                    Padding="8,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Home Link -->
                        <Button Command="{Binding BackHome}"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,6"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="10,7" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#EAEFF5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home20" FontSize="16" Foreground="#0067C0" Margin="0,0,10,0" />
                                <TextBlock Text="בית" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Quick Access Section -->
                        <TextBlock Text="גישה מהירה"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="10,6,10,4" />

                        <ItemsControl ItemsSource="{Binding SidebarQuickAccess}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Path}"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="10,6" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="5"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#EAEFF5" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#E5E8EC" Margin="8,8" />

                        <!-- This PC / Drives Section -->
                        <TextBlock Text="מחשב זה"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="10,2,10,4" />

                        <ItemsControl ItemsSource="{Binding SidebarDrives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Path}"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Button.ContextMenu>
                                            <ContextMenu FlowDirection="RightToLeft">
                                                <MenuItem Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Header="פתח"
                                                          FontWeight="SemiBold" />
                                                <MenuItem Command="{Binding DataContext.EjectDriveCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Header="הוצאה בטוחה"
                                                          Visibility="{Binding PlacementTarget.DataContext.IsRemovableDrive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="10,6" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="5"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#EAEFF5" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- File List (Details View) -->
            <ListView x:Name="items"
                      Grid.Column="1"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      Foreground="#1A1A1A"
                      Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVisibilityConverter}}"
                      FlowDirection="RightToLeft"
                      ItemsSource="{Binding FileSystemObjects}"
                      SelectedItem="{Binding CurrentFileSystemObject}"
                      SelectionMode="Extended"
                      VirtualizingPanel.CacheLength="5"
                      VirtualizingPanel.CacheLengthUnit="Item"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      GridViewColumnHeader.Click="GridViewColumnHeader_Click">

                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="Foreground" Value="#5C5C5C" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="BorderBrush" Value="#F0F2F5" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border x:Name="HeaderBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#F5F7FA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>

                <ListView.ContextMenu>
                    <ContextMenu FlowDirection="RightToLeft">
                        <MenuItem Command="{Binding CreateDirectoryCmd}" Header="תיקייה חדשה (Ctrl+Shift+N)" />
                        <MenuItem Command="{Binding PasteCmd}" Header="הדבק (Ctrl+V)" />
                        <Separator />
                        <MenuItem Command="{Binding RefreshCmd}" Header="רענן (F5)" />
                        <MenuItem Command="{Binding BackHome}" Header="חזרה לבית" />
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="#1A1A1A" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Margin" Value="6,1" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border x:Name="RowBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#F3F6FA" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#E5F1FB" />
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#CCE4F7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseDoubleClick" Handler="OnListViewItemDoubleClick" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.InputBindings>
                    <KeyBinding Command="{Binding OpenCmd}"
                                CommandParameter="{Binding CurrentFileSystemObject.Path}"
                                Gesture="Enter" />
                    <KeyBinding Command="{Binding OpenCmd}"
                                CommandParameter="{Binding CurrentFileSystemObject.Path}"
                                Gesture="Space" />
                    <KeyBinding Command="{Binding BackCmd}"
                                Gesture="Backspace" />
                    <KeyBinding Command="{Binding DeleteCmd}"
                                Key="Delete" />
                    <KeyBinding Command="{Binding RenameCmd}"
                                CommandParameter="{Binding CurrentFileSystemObject.Path}"
                                Key="F2" />
                    <KeyBinding Command="{Binding RefreshCmd}"
                                Key="F5" />
                    <KeyBinding Command="{Binding CopyCmd}"
                                Modifiers="Ctrl"
                                Key="C" />
                    <KeyBinding Command="{Binding CutCmd}"
                                Modifiers="Ctrl"
                                Key="X" />
                    <KeyBinding Command="{Binding PasteCmd}"
                                Modifiers="Ctrl"
                                Key="V" />
                </ListView.InputBindings>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="320">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" Content="שם" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{Binding Image}" Width="18" Height="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" Foreground="#1A1A1A" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="165">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="LastWriteTime" Content="תאריך שינוי" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Format}" Foreground="#5C5C5C" VerticalAlignment="Center" FontSize="12" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="155">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Type" Content="סוג" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" Foreground="#5C5C5C" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" Content="גודל" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Size, Converter={StaticResource BytesToNormalSizeConverter}}"
                                               Foreground="#5C5C5C"
                                               FlowDirection="LeftToRight"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="12" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Tiles / Large Icons View -->
            <ListBox x:Name="tilesList"
                     Grid.Column="1"
                     Background="#FFFFFF"
                     BorderThickness="0"
                     Padding="8"
                     FlowDirection="RightToLeft"
                     ItemsSource="{Binding FileSystemObjects}"
                     SelectedItem="{Binding CurrentFileSystemObject}"
                     SelectionMode="Extended"
                     Visibility="{Binding IsTilesView, Converter={StaticResource BoolToVisibilityConverter}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TileBorder"
                                            Width="112"
                                            Height="104"
                                            Margin="4"
                                            Padding="6"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileBorder" Property="Background" Value="#F3F6FA" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TileBorder" Property="Background" Value="#E5F1FB" />
                                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="#CCE4F7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseDoubleClick" Handler="OnListViewItemDoubleClick" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding Image}" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Name}" 
                                       HorizontalAlignment="Center" 
                                       TextAlignment="Center" 
                                       FontSize="12" 
                                       TextWrapping="Wrap" 
                                       MaxHeight="34" 
                                       TextTrimming="CharacterEllipsis" 
                                       Foreground="#1A1A1A" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter between List and Preview -->
            <GridSplitter Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#EAECEF"
                          Visibility="{Binding IsPreviewPaneVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Quick Preview Pane -->
            <Border Grid.Column="3"
                    Width="300"
                    FlowDirection="RightToLeft"
                    BorderThickness="1,0,0,0"
                    BorderBrush="#EAECEF"
                    Background="#F9FAFC"
                    Visibility="{Binding IsPreviewPaneVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="תצוגה מקדימה"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#1A1A1A"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right" />
                        <ui:Button Command="{Binding TogglePreviewPaneCmd}"
                                   Icon="Dismiss16"
                                   Foreground="#5C5C5C"
                                   Width="28"
                                   Height="28"
                                   MinWidth="0"
                                   MinHeight="0"
                                   Padding="0"
                                   Background="Transparent"
                                   BorderBrush="Transparent"
                                   DockPanel.Dock="Left"
                                   ToolTip="סגור תצוגה מקדימה" />
                    </DockPanel>

                    <!-- Preview Body -->
                    <Grid Grid.Row="1">
                        <!-- Text Preview -->
                        <Border Background="#FFFFFF"
                                BorderBrush="#E5E8EC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Visibility="{Binding PreviewInfo.TextContent, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding PreviewInfo.TextContent, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1A1A1A"
                                         FontFamily="Consolas"
                                         FontSize="12" />
                            </ScrollViewer>
                        </Border>

                        <!-- Image Preview -->
                        <Border Background="#FFFFFF"
                                BorderBrush="#E5E8EC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewInfo.Type}" Value="{x:Static models:PreviewType.Image}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding PreviewInfo.ImagePreview}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>

                        <!-- Document & Directory Card Preview -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewInfo.Type}" Value="{x:Static models:PreviewType.Document}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewInfo.Type}" Value="{x:Static models:PreviewType.Directory}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewInfo.Type}" Value="{x:Static models:PreviewType.None}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Image Source="{Binding PreviewInfo.IconPreview}"
                                   Width="64"
                                   Height="64"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />

                            <TextBlock Text="{Binding PreviewInfo.FileName}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="#1A1A1A"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="{Binding PreviewInfo.FileSizeFormatted}"
                                       Foreground="#5C5C5C"
                                       FontSize="12.5"
                                       TextAlignment="Center"
                                       Margin="0,0,0,4" />

                            <TextBlock Text="{Binding PreviewInfo.LastModifiedFormatted}"
                                       Foreground="#5C5C5C"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="{Binding PreviewInfo.StatusMessage}"
                                       Foreground="#6B7280"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Loading Indicator -->
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding PreviewInfo.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <!-- Preview Footer / Details -->
                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="10,6"
                            Background="#FFFFFF"
                            BorderBrush="#E5E8EC"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding PreviewInfo.FilePath, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
                        <TextBlock Text="{Binding PreviewInfo.FilePath}"
                                   Foreground="#5C5C5C"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PreviewInfo.FilePath}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
