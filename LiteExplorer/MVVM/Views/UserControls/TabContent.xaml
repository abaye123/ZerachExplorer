<UserControl x:Class="LiteExplorer.MVVM.Views.UserControls.TabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LiteExplorer.MVVM.Models"
             FontFamily="{StaticResource AppFont}"
             FontSize="14"
             Foreground="{StaticResource TextBrush}"
             Background="{StaticResource SurfaceBrush}"
             FlowDirection="RightToLeft"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Menus are outside the visual tree; the item carries its tab in Tag -->
        <ContextMenu x:Key="ItemMenu" Style="{StaticResource MenuPanel}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="פתח" Command="{Binding OpenCmd}" Icon="&#xE8E5;" InputGestureText="Enter" CommandParameter="{Binding CurrentFileSystemObject.Path}" />
            <MenuItem Header="פתח בכרטיסייה חדשה" Command="{Binding OpenInNewTabCmd}" Icon="&#xE8A7;" Visibility="{Binding CurrentFileSystemObject.IsDirectory, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            <Separator />
            <MenuItem Header="גזור" Command="{Binding CutCmd}" Icon="&#xE8C6;" InputGestureText="Ctrl+X" />
            <MenuItem Header="העתק" Command="{Binding CopyCmd}" Icon="&#xE8C8;" InputGestureText="Ctrl+C" />
            <MenuItem Header="שנה שם" Command="{Binding RenameCmd}" Icon="&#xE8AC;" InputGestureText="F2" />
            <MenuItem Header="מחק" Command="{Binding DeleteCmd}" Icon="&#xE74D;" InputGestureText="Delete" />
            <Separator Visibility="{Binding CurrentFileSystemObject.IsDirectory, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            <MenuItem Header="חשב גודל תיקייה" Command="{Binding CalculateFolderSizeCmd}" Icon="&#xE8EF;" Visibility="{Binding CurrentFileSystemObject.IsDirectory, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            <MenuItem Header="הוצאה בטוחה" Command="{Binding EjectDriveCmd}" Icon="&#xE88E;" CommandParameter="{Binding CurrentFileSystemObject.Path}" Visibility="{Binding CurrentFileSystemObject.IsRemovableDrive, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
        </ContextMenu>

        <ContextMenu x:Key="BackgroundMenu" Style="{StaticResource MenuPanel}">
            <MenuItem Header="הדבק" Command="{Binding PasteCmd}" Icon="&#xE77F;" InputGestureText="Ctrl+V" />
            <MenuItem Header="תיקייה חדשה" Command="{Binding CreateDirectoryCmd}" Icon="&#xE8F4;" InputGestureText="Ctrl+Shift+N" />
            <Separator />
            <MenuItem Header="רענן" Command="{Binding RefreshCmd}" Icon="&#xE72C;" InputGestureText="F5" />
        </ContextMenu>

        <DataTemplate x:Key="SidebarItem">
            <Button Style="{StaticResource SidebarButton}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}"
                    PreviewMouseDown="Sidebar_PreviewMouseDown"
                    ToolTip="{Binding Path}">
                <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource MenuPanel}" DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="פתח" Command="{Binding Tag.OpenCmd}" Icon="&#xE8E5;" CommandParameter="{Binding DataContext.Path}" />
                        <MenuItem Header="פתח בכרטיסייה חדשה" Command="{Binding Tag.OpenInNewTabCmd}" Icon="&#xE8A7;" CommandParameter="{Binding DataContext.Path}" />
                        <MenuItem Header="הוצאה בטוחה" Command="{Binding Tag.EjectDriveCmd}" Icon="&#xE88E;" CommandParameter="{Binding DataContext.Path}" Visibility="{Binding DataContext.IsRemovableDrive, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <DockPanel>
                    <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,10,0" Style="{StaticResource SharpImage}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" />
                </DockPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource ExplorerRow}">
            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />
        </Style>
        <Style x:Key="TileStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ExplorerItem}">
            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />
            <Setter Property="Width" Value="124" />
            <Setter Property="Height" Value="136" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
        </Style>
        <Style x:Key="DriveStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ExplorerItem}">
            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />
            <Setter Property="Width" Value="300" />
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding CopyCmd}" Modifiers="Ctrl" Key="C" />
        <KeyBinding Command="{Binding CutCmd}" Modifiers="Ctrl" Key="X" />
        <KeyBinding Command="{Binding PasteCmd}" Modifiers="Ctrl" Key="V" />
        <KeyBinding Command="{Binding CreateDirectoryCmd}" Modifiers="Ctrl+Shift" Key="N" />
        <KeyBinding Command="{Binding DeleteCmd}" Key="Delete" />
        <KeyBinding Command="{Binding RenameCmd}" Key="F2" />
        <KeyBinding Command="{Binding RefreshCmd}" Key="F5" />
        <KeyBinding Command="{Binding RefreshCmd}" Modifiers="Ctrl" Key="R" />
        <KeyBinding Command="{Binding BackCmd}" Modifiers="Alt" Key="Left" />
        <KeyBinding Command="{Binding ForwardCmd}" Modifiers="Alt" Key="Right" />
        <KeyBinding Command="{Binding UpCmd}" Modifiers="Alt" Key="Up" />
        <KeyBinding Command="{Binding BackCmd}" Key="BrowserBack" />
        <KeyBinding Command="{Binding ForwardCmd}" Key="BrowserForward" />
        <KeyBinding Command="{Binding ToggleAddressBarEditCmd}" Modifiers="Ctrl" Key="L" />
        <KeyBinding Command="{Binding ToggleAddressBarEditCmd}" Modifiers="Alt" Key="D" />
        <KeyBinding Command="{Binding TogglePreviewPaneCmd}" Modifiers="Alt" Key="P" />
        <KeyBinding Command="{Binding ToggleViewModeCmd}" Modifiers="Ctrl+Shift" Key="V" />
        <KeyBinding Command="{Binding OpenAdminCmd}" Modifiers="Ctrl+Shift" Key="A" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation, address and search -->
        <Border Background="{StaticResource ToolbarBrush}" Padding="8,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" MinWidth="180" MaxWidth="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <!-- In a right-to-left window "back" points right -->
                    <Button Content="&#xE72A;" Style="{StaticResource IconButton}" Command="{Binding BackCmd}" ToolTip="אחורה (Alt+שמאלה)" />
                    <Button Content="&#xE72B;" Style="{StaticResource IconButton}" Command="{Binding ForwardCmd}" ToolTip="קדימה (Alt+ימינה)" />
                    <Button Content="&#xE74A;" Style="{StaticResource IconButton}" Command="{Binding UpCmd}" ToolTip="למעלה (Alt+חץ למעלה)" />
                    <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding RefreshCmd}" ToolTip="רענן (F5)" />
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource FieldFrame}">
                    <Grid>
                        <Grid Background="Transparent"
                              MouseLeftButtonDown="Address_MouseLeftButtonDown"
                              Visibility="{Binding IsAddressBarEditing, Converter={StaticResource InverseBoolToVisibility}}">
                            <ScrollViewer x:Name="BreadcrumbScroll"
                                          Margin="6,0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ItemsControl ItemsSource="{Binding Breadcrumbs}" Focusable="False" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource FlatButton}"
                                                        MinHeight="28"
                                                        MinWidth="0"
                                                        Padding="8,0"
                                                        Command="{Binding DataContext.NavigateBreadcrumbCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Path}">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" MaxWidth="240" />
                                                </Button>
                                                <TextBlock Text="&#xE76B;"
                                                           Style="{StaticResource Glyph}"
                                                           FontSize="9"
                                                           Margin="5,1,5,0"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <TextBox x:Name="AddressInput"
                                 Style="{StaticResource BareTextBox}"
                                 FlowDirection="LeftToRight"
                                 Margin="10,0"
                                 LostKeyboardFocus="AddressInput_LostKeyboardFocus"
                                 Visibility="{Binding IsAddressBarEditing, Converter={StaticResource BoolToVisibility}}"
                                 Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitAddressCmd}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelAddressCmd}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource FieldFrame}" Margin="8,0,0,0">
                    <DockPanel>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" Margin="12,0,8,0" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button DockPanel.Dock="Right"
                                Content="&#xE711;"
                                Style="{StaticResource IconButton}"
                                FontSize="10"
                                Width="28"
                                MinWidth="28"
                                MinHeight="28"
                                Margin="4,0"
                                Command="{Binding ClearSearchCmd}"
                                ToolTip="נקה חיפוש (Esc)"
                                Visibility="{Binding SearchText, Converter={StaticResource TextToVisibility}}" />
                        <Grid>
                            <TextBlock Text="{Binding SearchHint}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       IsHitTestVisible="False"
                                       Margin="2,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchInput"
                                     Style="{StaticResource BareTextBox}"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCmd}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Commands -->
        <Border Grid.Row="1"
                Background="{StaticResource CommandBarBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1"
                Padding="8,5">
            <DockPanel LastChildFill="False">
                <Button Style="{StaticResource FlatButton}" MinHeight="38" Command="{Binding CreateDirectoryCmd}" ToolTip="תיקייה חדשה (Ctrl+Shift+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xECC8;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="תיקייה חדשה" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="24" Margin="8,0" Background="{StaticResource LineBrush}" />
                <Button Content="&#xE8C6;" Style="{StaticResource CommandIconButton}" Command="{Binding CutCmd}" ToolTip="גזור (Ctrl+X)" />
                <Button Content="&#xE8C8;" Style="{StaticResource CommandIconButton}" Command="{Binding CopyCmd}" ToolTip="העתק (Ctrl+C)" />
                <Button Content="&#xE77F;" Style="{StaticResource CommandIconButton}" Command="{Binding PasteCmd}" ToolTip="הדבק (Ctrl+V)" />
                <Button Content="&#xE8AC;" Style="{StaticResource CommandIconButton}" Command="{Binding RenameCmd}" ToolTip="שנה שם (F2)" />
                <Button Content="&#xE74D;" Style="{StaticResource CommandIconButton}" Command="{Binding DeleteCmd}" ToolTip="מחק (Delete)" />
                <Border Width="1" Height="24" Margin="8,0" Background="{StaticResource LineBrush}" />

                <Button Style="{StaticResource FlatButton}" MinHeight="38" Click="OpenMenu_Click" ToolTip="מיון">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource MenuPanel}">
                    <MenuItem Header="שם" Command="{Binding SortCmd}" CommandParameter="Name" />
                    <MenuItem Header="תאריך שינוי" Command="{Binding SortCmd}" CommandParameter="LastWriteTime" />
                    <MenuItem Header="סוג" Command="{Binding SortCmd}" CommandParameter="Type" />
                    <MenuItem Header="גודל" Command="{Binding SortCmd}" CommandParameter="Size" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="מיון" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" Margin="8,2,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource FlatButton}" MinHeight="38" Click="OpenMenu_Click" ToolTip="תצוגה">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource MenuPanel}">
                            <MenuItem Header="סמלים גדולים" Icon="&#xF0E2;" IsChecked="{Binding IsTilesView, Mode=OneWay}" Command="{Binding SetViewCmd}" CommandParameter="Tiles" />
                            <MenuItem Header="פרטים" Icon="&#xEA37;" IsChecked="{Binding IsDetailsView, Mode=OneWay}" Command="{Binding SetViewCmd}" CommandParameter="Details" />
                            <Separator />
                            <MenuItem Header="חלונית תצוגה מקדימה" Icon="&#xE90D;" InputGestureText="Alt+P" IsChecked="{Binding IsPreviewPaneVisible, Mode=OneWay}" Command="{Binding TogglePreviewPaneCmd}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA37;" Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="תצוגה" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" Margin="8,2,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource IconButton}" Command="{Binding OpenAboutCmd}" ToolTip="אודות" />
                <Button DockPanel.Dock="Right" Content="&#xE713;" Style="{StaticResource IconButton}" Command="{Binding OpenAdminCmd}" ToolTip="הגדרות מנהל (Ctrl+Shift+A)" />
                <Border DockPanel.Dock="Right" Width="1" Height="24" Margin="8,0" Background="{StaticResource LineBrush}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" MinHeight="38" Command="{Binding TogglePreviewPaneCmd}" ToolTip="תצוגה מקדימה (Alt+P)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90C;" Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="תצוגה מקדימה" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Sidebar, files and preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="8,8">
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding BackHome}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="בית" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidebarQuickAccess.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="10,8" />
                        <ItemsControl ItemsSource="{Binding SidebarQuickAccess}" ItemTemplate="{StaticResource SidebarItem}" Focusable="False" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="10,8" />
                    <TextBlock Text="מחשב זה" Style="{StaticResource Caption}" Margin="10,2,10,6" />
                    <ItemsControl ItemsSource="{Binding SidebarDrives}" ItemTemplate="{StaticResource SidebarItem}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Focusable="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Width="1" Background="{StaticResource LineBrush}" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Grid Grid.Column="2">
                <!-- Home -->
                <ListBox x:Name="drivesList"
                      Padding="12,8"
                      FlowDirection="RightToLeft"
                      Background="{StaticResource SurfaceBrush}"
                      BorderThickness="0"
                      FontSize="14"
                      ItemsSource="{Binding FileSystemObjects}"
                      SelectedItem="{Binding CurrentFileSystemObject}"
                      SelectionMode="Extended"
                      TextSearch.TextPath="Name"
                      ContextMenu="{StaticResource BackgroundMenu}"
                      PreviewMouseDown="List_PreviewMouseDown"
                      PreviewMouseWheel="List_PreviewMouseWheel"
                      MouseDoubleClick="List_MouseDoubleClick"
                      PreviewKeyDown="List_PreviewKeyDown"
                      ItemContainerStyle="{StaticResource DriveStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Image Source="{Binding LargeImage}" Width="48" Height="48" Margin="0,0,14,0" Style="{StaticResource SharpImage}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" />
                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Style="{StaticResource SpaceBar}" Margin="0,5,0,4" Visibility="{Binding ShowSpace, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding SpaceText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Visibility="{Binding ShowSpace, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Details -->
                <ListView x:Name="items"
                      Padding="8,0"
                      FlowDirection="RightToLeft"
                      Background="{StaticResource SurfaceBrush}"
                      BorderThickness="0"
                      FontSize="14"
                      ItemsSource="{Binding FileSystemObjects}"
                      SelectedItem="{Binding CurrentFileSystemObject}"
                      SelectionMode="Extended"
                      TextSearch.TextPath="Name"
                      ContextMenu="{StaticResource BackgroundMenu}"
                      PreviewMouseDown="List_PreviewMouseDown"
                      PreviewMouseWheel="List_PreviewMouseWheel"
                      MouseDoubleClick="List_MouseDoubleClick"
                      PreviewKeyDown="List_PreviewKeyDown"
                      ItemContainerStyle="{StaticResource RowStyle}"
                      Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeader}">
                        <GridViewColumn Width="400">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" Content="שם" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Name}">
                                        <Image Source="{Binding Image}" Width="16" Height="16" Margin="4,0,10,0" Style="{StaticResource SharpImage}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource NameText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="160">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="LastWriteTime" Content="תאריך שינוי" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastWriteTime}" Style="{StaticResource ValueText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="190">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Type" Content="סוג" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" Style="{StaticResource NameText}" Foreground="{StaticResource SecondaryTextBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="110">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" Content="גודל" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Size, Converter={StaticResource BytesToNormalSize}}" x:Name="SizeText" Style="{StaticResource ValueText}" />
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDirectory}" Value="True" />
                                                <Condition Binding="{Binding Size}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="SizeText" Property="Visibility" Value="Hidden" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsCalculatingSize}" Value="True">
                                            <Setter TargetName="SizeText" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="SizeText" Property="Text" Value="מחשב..." />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Large icons -->
                <ListBox x:Name="tilesList"
                      Padding="12,8"
                      FlowDirection="RightToLeft"
                      Background="{StaticResource SurfaceBrush}"
                      BorderThickness="0"
                      FontSize="14"
                      ItemsSource="{Binding FileSystemObjects}"
                      SelectedItem="{Binding CurrentFileSystemObject}"
                      SelectionMode="Extended"
                      TextSearch.TextPath="Name"
                      ContextMenu="{StaticResource BackgroundMenu}"
                      PreviewMouseDown="List_PreviewMouseDown"
                      PreviewMouseWheel="List_PreviewMouseWheel"
                      MouseDoubleClick="List_MouseDoubleClick"
                      PreviewKeyDown="List_PreviewKeyDown"
                      ItemContainerStyle="{StaticResource TileStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowTiles, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Image Source="{Binding LargeImage}" Width="48" Height="48" Margin="0,2,0,8" HorizontalAlignment="Center" Style="{StaticResource SharpImage}" />
                                <TextBlock Text="{Binding Name}"
                                           FlowDirection="{Binding Name, Converter={StaticResource TextDirection}}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="18"
                                           MaxHeight="56"
                                           FontSize="13" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding EmptyText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="20,90,20,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           IsHitTestVisible="False" />

                <ProgressBar Height="3"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Preview -->
            <Border Grid.Column="3"
                    Width="310"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPreviewPaneVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="168" Background="#F9F9F9">
                        <Image Source="{Binding PreviewInfo.IconPreview}" Width="96" Height="96" Style="{StaticResource SharpImage}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,0">
                        <TextBlock Text="{Binding PreviewInfo.FileName}"
                                   FlowDirection="{Binding PreviewInfo.FileName, Converter={StaticResource TextDirection}}"
                                   HorizontalAlignment="Left"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PreviewInfo.Summary}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding PreviewInfo.Summary, Converter={StaticResource TextToVisibility}}" />
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,14,0,0">
                            <DockPanel>
                                <TextBlock Text="&#xF167;" Style="{StaticResource Glyph}" VerticalAlignment="Top" Margin="0,2,12,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding PreviewInfo.StatusMessage}" FontSize="13" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding PreviewInfo.FilePath, Converter={StaticResource TextToVisibility}}">
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12" />
                            <DockPanel>
                                <TextBlock Text="גודל" Width="90" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding PreviewInfo.FileSizeFormatted}" Style="{StaticResource NameText}" FontSize="13" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,12">
                                <TextBlock Text="תאריך שינוי" Width="90" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding PreviewInfo.LastModifiedFormatted}" FontSize="13" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            </DockPanel>
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding PreviewInfo.IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Background="#FAFAFA"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="20,0,20,18"
                            VerticalAlignment="Stretch"
                            Visibility="{Binding PreviewInfo.TextContent, Converter={StaticResource TextToVisibility}}">
                        <TextBox Text="{Binding PreviewInfo.TextContent, Mode=OneWay}"
                                 Style="{StaticResource BareTextBox}"
                                 FlowDirection="{Binding PreviewInfo.TextContent, Converter={StaticResource TextDirection}}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontSize="13"
                                 Padding="10"
                                 VerticalContentAlignment="Stretch"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Padding="14,0,8,0" Height="32" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding ItemsText}" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                <Border Width="1" Height="14" Margin="14,0" Background="{StaticResource LineBrush}" Visibility="{Binding SelectionText, Converter={StaticResource TextToVisibility}}" />
                <TextBlock Text="{Binding SelectionText}" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                <Button Style="{StaticResource FlatButton}"
                        MinHeight="26"
                        Margin="14,0"
                        Command="{Binding Operations.ShowCmd}"
                        ToolTip="הצג את חלון הפעולות"
                        Visibility="{Binding Operations.HasVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Operations.StatusText}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button DockPanel.Dock="Right" Content="&#xF0E2;" Style="{StaticResource IconButton}" MinHeight="26" Width="32" FontSize="14" Command="{Binding SetViewCmd}" CommandParameter="Tiles" ToolTip="סמלים גדולים" />
                <Button DockPanel.Dock="Right" Content="&#xEA37;" Style="{StaticResource IconButton}" MinHeight="26" Width="32" FontSize="14" Command="{Binding SetViewCmd}" CommandParameter="Details" ToolTip="פרטים" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
