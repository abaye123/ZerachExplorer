<UserControl x:Class="LiteExplorer.MVVM.Views.UserControls.TabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LiteExplorer.MVVM.ViewModels"
             xmlns:c="clr-namespace:LiteExplorer.Infrastructure.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             d:DataContext="{d:DesignInstance vm:TabContentViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding RunCmd}" Modifiers="Ctrl" Key="Oem3" />
        <KeyBinding Command="{Binding CopyCmd}" Modifiers="Ctrl" Key="C" />
        <KeyBinding Command="{Binding CutCmd}" Modifiers="Ctrl" Key="X" />
        <KeyBinding Command="{Binding PasteCmd}" Modifiers="Ctrl" Key="V" />
        <KeyBinding Command="{Binding CreateDirectoryCmd}" Modifiers="Ctrl+Shift" Key="N" />
        <KeyBinding Command="{Binding DeleteCmd}" Key="Delete" />
        <KeyBinding Command="{Binding RenameCmd}" CommandParameter="{Binding CurrentFileSystemObject.Path}" Key="F2" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Command="{Binding BackHome}"
                       Icon="Home32"
                       Content="בית"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       Height="38"
                       ToolTip="בית" />

            <ui:Button Grid.Column="1"
                       Command="{Binding BackCmd}"
                       Icon="ArrowUp32"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       Height="38"
                       ToolTip="חזור אחורה (Backspace)" />

            <ui:TextBox Grid.Column="2"
                        HorizontalContentAlignment="Stretch"
                        Icon="Desktop32"
                        FlowDirection="RightToLeft"
                        Text="{Binding TabPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Gesture="Enter"
                                Command="{Binding OpenCmd}"
                                CommandParameter="{Binding TabPath}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>

            <ui:Button Grid.Column="3"
                       Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                       Command="{Binding OpenCmd}"
                       CommandParameter="{Binding TabPath}"
                       Icon="ArrowClockwise32"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       ToolTip="פתח את הנתיב המצוין (רענן)" />

            <ui:Button Grid.Column="4"
                       Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                       Command="{Binding CreateDirectoryCmd}"
                       Icon="FolderAdd24"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       ToolTip="תיקייה חדשה (Ctrl+Shift+N)" />

            <ui:Button Grid.Column="5"
                       Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                       Command="{Binding CopyCmd}"
                       Icon="Copy24"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       ToolTip="העתק (Ctrl+C)" />

            <ui:Button Grid.Column="6"
                       Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                       Command="{Binding PasteCmd}"
                       Icon="ClipboardPaste24"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       ToolTip="הדבק (Ctrl+V)" />

            <ui:Button Grid.Column="7"
                       Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                       Command="{Binding EjectDriveCmd}"
                       Icon="UsbPlug24"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       ToolTip="הוצאה בטוחה של כונן נשלף" />

            <ui:Button Grid.Column="8"
                       Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                       Command="{Binding OpenAboutCmd}"
                       CommandParameter="{Binding TabPath}"
                       Icon="Info24"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       ToolTip="אודות והגדרות" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
        </Grid>

        <ListView x:Name="items"
                  Grid.Row="1"
                  FlowDirection="RightToLeft"
                  ItemsSource="{Binding FileSystemObjects}"
                  SelectedItem="{Binding CurrentFileSystemObject}"
                  SelectionMode="Extended"
                  VirtualizingPanel.CacheLength="5"
                  VirtualizingPanel.CacheLengthUnit="Item"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CreateDirectoryCmd}" Header="תיקייה חדשה (Ctrl+Shift+N)" />
                    <MenuItem Command="{Binding PasteCmd}" Header="הדבק (Ctrl+V)" />
                    <MenuItem Command="{Binding BackHome}" Header="חזרה לבית" />
                    <MenuItem Command="{Binding EjectDriveCmd}" Header="הוצאה בטוחה של כונן" />
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.Resources>
                <ContextMenu x:Key="ItemContextMenu">
                    <MenuItem Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem.Path}"
                              Header="פתח" />
                    <Separator />
                    <MenuItem Command="{Binding DataContext.CopyCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Header="העתק (Ctrl+C)" />
                    <MenuItem Command="{Binding DataContext.CutCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Header="גזור (Ctrl+X)" />
                    <MenuItem Command="{Binding DataContext.PasteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Header="הדבק (Ctrl+V)" />
                    <Separator />
                    <MenuItem Command="{Binding DataContext.DeleteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem.Path}"
                              Header="מחק (Delete)" />
                    <MenuItem Command="{Binding DataContext.RenameCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem.Path}"
                              Header="שינוי שם (F2)" />
                    <MenuItem Command="{Binding DataContext.CreateDirectoryCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Header="תיקייה חדשה (Ctrl+Shift+N)" />
                    <Separator />
                    <MenuItem Command="{Binding DataContext.EjectDriveCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Header="הוצאה בטוחה של כונן" />
                    <MenuItem Command="{Binding DataContext.CalculateFolderSizeCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem}"
                              Header="חשב גודל תיקייה" />
                </ContextMenu>
            </ListView.Resources>

            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type ListViewItem}}"
                       TargetType="{x:Type ListViewItem}">
                    <Setter Property="ContextMenu"
                            Value="{StaticResource ItemContextMenu}" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.InputBindings>
                <KeyBinding Command="{Binding OpenCmd}"
                            CommandParameter="{Binding CurrentFileSystemObject.Path}"
                            Gesture="Enter" />
                <KeyBinding Command="{Binding OpenCmd}"
                            CommandParameter="{Binding CurrentFileSystemObject.Path}"
                            Gesture="Space" />
                <KeyBinding Command="{Binding BackCmd}"
                            Gesture="Backspace" />
                <KeyBinding Command="{Binding DeleteCmd}"
                            Key="Delete" />
            </ListView.InputBindings>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <DataTemplate.Resources>
                        <c:UsedPercent x:Key="UsedPercentConverter" />
                        <c:BytesToNormalSize x:Key="BytesToNormalSizeConverter" />
                        <c:PercentToColor x:Key="PercentToColorConverter" />
                    </DataTemplate.Resources>

                    <Grid>
                        <Grid.InputBindings>
                            <MouseBinding Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding DataContext.CurrentFileSystemObject.Path, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Gesture="LeftDoubleClick" />
                        </Grid.InputBindings>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Margin="0,0,5,3"
                                   Source="{Binding Image}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                        </Grid>
                        <Label Grid.Column="1"
                               Content="{Binding Format}" Foreground="Gray" FontSize="13"/>
                        <Label Grid.Column="2"
                               Content="{Binding Type}"  Foreground="Gray" FontSize="13"/>
                        <Label Grid.Column="3"
                               Content="{Binding TotalSpace, Converter={StaticResource BytesToNormalSizeConverter}}"  Foreground="Gray" FontSize="13"/>
                        <Label Grid.Column="4"
                               Content="{Binding Size, Converter={StaticResource BytesToNormalSizeConverter}}"
                               Foreground="Gray" FlowDirection="LeftToRight" FontSize="13"/>
                        <Label Grid.Column="5"
                               Content="{Binding FreeSpace, Converter={StaticResource BytesToNormalSizeConverter}}"
                               Foreground="Green" FlowDirection="LeftToRight" FontSize="13"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
