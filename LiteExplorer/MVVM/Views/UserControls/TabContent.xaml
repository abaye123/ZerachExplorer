<UserControl x:Class="LiteExplorer.MVVM.Views.UserControls.TabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LiteExplorer.MVVM.ViewModels"
             xmlns:models="clr-namespace:LiteExplorer.MVVM.Models"
             xmlns:c="clr-namespace:LiteExplorer.Infrastructure.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             d:DataContext="{d:DesignInstance vm:TabContentViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <c:BytesToNormalSize x:Key="BytesToNormalSizeConverter" />
        <c:BoolToVisibility x:Key="BoolToVisibilityConverter" />
        <c:InverseBoolToVisibility x:Key="InverseBoolToVisibilityConverter" />
        <c:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Command="{Binding RunCmd}" Modifiers="Ctrl" Key="Oem3" />
        <KeyBinding Command="{Binding CopyCmd}" Modifiers="Ctrl" Key="C" />
        <KeyBinding Command="{Binding CutCmd}" Modifiers="Ctrl" Key="X" />
        <KeyBinding Command="{Binding PasteCmd}" Modifiers="Ctrl" Key="V" />
        <KeyBinding Command="{Binding CreateDirectoryCmd}" Modifiers="Ctrl+Shift" Key="N" />
        <KeyBinding Command="{Binding DeleteCmd}" Key="Delete" />
        <KeyBinding Command="{Binding RenameCmd}" CommandParameter="{Binding CurrentFileSystemObject.Path}" Key="F2" />
        <KeyBinding Command="{Binding RefreshCmd}" Key="F5" />
        <KeyBinding Command="{Binding TogglePreviewPaneCmd}" Modifiers="Alt" Key="P" />
        <KeyBinding Command="{Binding ToggleViewModeCmd}" Modifiers="Ctrl+Shift" Key="V" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command Toolbar (Windows Explorer Ribbon Bar) -->
        <Border Grid.Row="0"
                FlowDirection="RightToLeft"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                Padding="6,4">
            <Border.Resources>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Margin" Value="6,4" />
                    <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                </Style>
            </Border.Resources>

            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ui:Button Command="{Binding CreateDirectoryCmd}"
                               Icon="FolderAdd24"
                               Content="תיקייה חדשה"
                               ToolTip="תיקייה חדשה (Ctrl+Shift+N)" />

                    <Separator />

                    <ui:Button Command="{Binding CutCmd}"
                               Icon="Cut24"
                               Width="38"
                               Padding="0"
                               ToolTip="גזור (Ctrl+X)" />

                    <ui:Button Command="{Binding CopyCmd}"
                               Icon="Copy24"
                               Width="38"
                               Padding="0"
                               ToolTip="העתק (Ctrl+C)" />

                    <ui:Button Command="{Binding PasteCmd}"
                               Icon="ClipboardPaste24"
                               Width="38"
                               Padding="0"
                               ToolTip="הדבק (Ctrl+V)" />

                    <ui:Button Command="{Binding RenameCmd}"
                               CommandParameter="{Binding CurrentFileSystemObject.Path}"
                               Icon="Rename24"
                               Width="38"
                               Padding="0"
                               ToolTip="שינוי שם (F2)" />

                    <ui:Button Command="{Binding DeleteCmd}"
                               CommandParameter="{Binding CurrentFileSystemObject.Path}"
                               Icon="Delete24"
                               Width="38"
                               Padding="0"
                               ToolTip="מחק (Delete)" />

                    <Separator />

                    <ui:Button Command="{Binding EjectDriveCmd}"
                               Icon="UsbPlug24"
                               Content="הוצאה בטוחה"
                               ToolTip="הוצאה בטוחה של כונן נשלף" />

                    <Separator />

                    <ui:Button Command="{Binding TogglePreviewPaneCmd}"
                               Icon="Eye24"
                               Content="תצוגה מקדימה"
                               ToolTip="הצג או הסתר חלונית תצוגה מקדימה (Alt+P)" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Command="{Binding RefreshCmd}"
                               Icon="ArrowClockwise24"
                               Width="38"
                               Padding="0"
                               ToolTip="רענן (F5)" />

                    <ui:Button Command="{Binding OpenAboutCmd}"
                               CommandParameter="{Binding TabPath}"
                               Icon="Info24"
                               Width="38"
                               Padding="0"
                               ToolTip="אודות והגדרות" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigation, Breadcrumbs & Search Bar -->
        <Grid Grid.Row="1" FlowDirection="RightToLeft" Margin="4,4,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Command="{Binding BackHome}"
                       Icon="Home32"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       Height="38"
                       Width="40"
                       Padding="0"
                       ToolTip="בית (כל הכוננים)" />

            <ui:Button Grid.Column="1"
                       Command="{Binding BackCmd}"
                       Icon="ArrowUp32"
                       BorderBrush="Transparent"
                       Background="Transparent"
                       Height="38"
                       Width="40"
                       Padding="0"
                       ToolTip="תיקיית אב (Backspace)" />

            <!-- Interactive Breadcrumbs & Address Bar -->
            <Grid Grid.Column="2" Margin="4,0">
                <!-- Breadcrumbs display mode -->
                <Border Visibility="{Binding IsAddressBarEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Height="38"
                        Padding="6,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.NavigateBreadcrumbCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}"
                                                    Content="{Binding Name}"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Padding="6,4"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand" />
                                            <TextBlock Text="›"
                                                       VerticalAlignment="Center"
                                                       Margin="2,0"
                                                       Foreground="Gray"
                                                       FontSize="14"
                                                       Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ui:Button Grid.Column="1"
                                   Command="{Binding ToggleAddressBarEditCmd}"
                                   Icon="Edit24"
                                   Width="30"
                                   Height="30"
                                   Padding="0"
                                   Background="Transparent"
                                   BorderBrush="Transparent"
                                   ToolTip="ערוך נתיב כטקסט" />
                    </Grid>
                </Border>

                <!-- Text Edit mode -->
                <Grid Visibility="{Binding IsAddressBarEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                HorizontalContentAlignment="Stretch"
                                Icon="Desktop32"
                                FlowDirection="RightToLeft"
                                FontSize="13"
                                Text="{Binding TabPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Gesture="Enter"
                                        Command="{Binding OpenCmd}"
                                        CommandParameter="{Binding TabPath}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1"
                               Command="{Binding ToggleAddressBarEditCmd}"
                               Icon="Checkmark24"
                               Width="38"
                               Height="38"
                               Padding="0"
                               Margin="4,0,0,0"
                               ToolTip="סיום עריכת נתיב" />
                </Grid>
            </Grid>

            <!-- Quick Filter / Search Box -->
            <Grid Grid.Column="3" Margin="4,0,0,0" Width="220">
                <ui:TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Icon="Search24"
                            PlaceholderText="חיפוש בתיקייה זו..."
                            FontSize="13"
                            Height="38"
                            Padding="8,0,32,0" />
                <ui:Button Command="{Binding ClearSearchCmd}"
                           Icon="Dismiss16"
                           Width="28"
                           Height="28"
                           Padding="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           Background="Transparent"
                           BorderBrush="Transparent"
                           ToolTip="נקה חיפוש"
                           Visibility="{Binding SearchText, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <!-- Main Workspace: File List + Splitter + Quick Preview Pane -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- File List -->
            <ListView x:Name="items"
                      Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVisibilityConverter}}"
                      Grid.Column="0"
                      FlowDirection="RightToLeft"
                      ItemsSource="{Binding FileSystemObjects}"
                      SelectedItem="{Binding CurrentFileSystemObject}"
                      SelectionMode="Extended"
                      VirtualizingPanel.CacheLength="5"
                      VirtualizingPanel.CacheLengthUnit="Item"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      GridViewColumnHeader.Click="GridViewColumnHeader_Click">

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding CreateDirectoryCmd}" Header="תיקייה חדשה (Ctrl+Shift+N)" />
                        <MenuItem Command="{Binding PasteCmd}" Header="הדבק (Ctrl+V)" />
                        <MenuItem Command="{Binding BackHome}" Header="חזרה לבית" />
                        <MenuItem Command="{Binding EjectDriveCmd}" Header="הוצאה בטוחה של כונן" />
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.Resources>
                    <ContextMenu x:Key="ItemContextMenu">
                        <MenuItem Command="{Binding DataContext.OpenCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem.Path}"
                                  Header="פתח" />
                        <Separator />
                        <MenuItem Command="{Binding DataContext.CutCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Header="גזור (Ctrl+X)" />
                        <MenuItem Command="{Binding DataContext.CopyCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Header="העתק (Ctrl+C)" />
                        <MenuItem Command="{Binding DataContext.PasteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Header="הדבק (Ctrl+V)" />
                        <Separator />
                        <MenuItem Command="{Binding DataContext.RenameCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem.Path}"
                                  Header="שינוי שם (F2)" />
                        <MenuItem Command="{Binding DataContext.DeleteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem.Path}"
                                  Header="מחק (Delete)" />
                        <MenuItem Command="{Binding DataContext.CreateDirectoryCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Header="תיקייה חדשה (Ctrl+Shift+N)" />
                        <Separator />
                        <MenuItem Command="{Binding DataContext.EjectDriveCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Header="הוצאה בטוחה של כונן" />
                        <MenuItem Command="{Binding DataContext.CalculateFolderSizeCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=SelectedItem}"
                                  Header="חשב גודל תיקייה" />
                    </ContextMenu>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListViewItem}}"
                           TargetType="{x:Type ListViewItem}">
                        <Setter Property="ContextMenu"
                                Value="{StaticResource ItemContextMenu}" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <EventSetter Event="MouseDoubleClick"
                                     Handler="OnListViewItemDoubleClick" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.InputBindings>
                    <KeyBinding Command="{Binding OpenCmd}"
                                CommandParameter="{Binding CurrentFileSystemObject.Path}"
                                Gesture="Enter" />
                    <KeyBinding Command="{Binding OpenCmd}"
                                CommandParameter="{Binding CurrentFileSystemObject.Path}"
                                Gesture="Space" />
                    <KeyBinding Command="{Binding BackCmd}"
                                Gesture="Backspace" />
                    <KeyBinding Command="{Binding DeleteCmd}"
                                Key="Delete" />
                    <KeyBinding Command="{Binding RenameCmd}"
                                CommandParameter="{Binding CurrentFileSystemObject.Path}"
                                Key="F2" />
                    <KeyBinding Command="{Binding RefreshCmd}"
                                Key="F5" />
                    <KeyBinding Command="{Binding CopyCmd}"
                                Modifiers="Ctrl"
                                Key="C" />
                    <KeyBinding Command="{Binding CutCmd}"
                                Modifiers="Ctrl"
                                Key="X" />
                    <KeyBinding Command="{Binding PasteCmd}"
                                Modifiers="Ctrl"
                                Key="V" />
                </ListView.InputBindings>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="320">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" Content="שם" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{Binding Image}" Width="20" Height="20" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="180">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="LastWriteTime" Content="תאריך שינוי" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Format}" Foreground="Gray" VerticalAlignment="Center" FontSize="13" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="130">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Type" Content="סוג" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" Foreground="Gray" VerticalAlignment="Center" FontSize="13" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="130">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" Content="גודל" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Size, Converter={StaticResource BytesToNormalSizeConverter}}"
                                               Foreground="Gray"
                                               FlowDirection="LeftToRight"
                                               VerticalAlignment="Center"
                                               FontSize="13" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Tiles / Large Icons View -->
            <ListBox x:Name="tilesList"
                     Grid.Column="0"
                     FlowDirection="RightToLeft"
                     ItemsSource="{Binding FileSystemObjects}"
                     SelectedItem="{Binding CurrentFileSystemObject}"
                     SelectionMode="Extended"
                     Visibility="{Binding IsTilesView, Converter={StaticResource BoolToVisibilityConverter}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="OnListViewItemDoubleClick" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="110" Height="100" Margin="6" Padding="6" CornerRadius="6" Background="Transparent">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding Image}" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Name}" 
                                           HorizontalAlignment="Center" 
                                           TextAlignment="Center" 
                                           FontSize="12" 
                                           TextWrapping="Wrap" 
                                           MaxHeight="36" 
                                           TextTrimming="CharacterEllipsis" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter between List and Preview -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"
                          Visibility="{Binding IsPreviewPaneVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Quick Preview Pane -->
            <Border Grid.Column="2"
                    Width="320"
                    FlowDirection="RightToLeft"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    Visibility="{Binding IsPreviewPaneVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="תצוגה מקדימה"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right" />
                        <ui:Button Command="{Binding TogglePreviewPaneCmd}"
                                   Icon="Dismiss16"
                                   Width="28"
                                   Height="28"
                                   Padding="0"
                                   Background="Transparent"
                                   BorderBrush="Transparent"
                                   DockPanel.Dock="Left"
                                   ToolTip="סגור תצוגה מקדימה" />
                    </DockPanel>

                    <!-- Preview Body -->
                    <Grid Grid.Row="1">
                        <!-- Text Preview -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Visibility="{Binding PreviewInfo.TextContent, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding PreviewInfo.TextContent, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas"
                                         FontSize="12" />
                            </ScrollViewer>
                        </Border>

                        <!-- Image Preview -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewInfo.Type}" Value="{x:Static models:PreviewType.Image}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding PreviewInfo.ImagePreview}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>

                        <!-- Document & Directory Card Preview -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewInfo.Type}" Value="{x:Static models:PreviewType.Document}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewInfo.Type}" Value="{x:Static models:PreviewType.Directory}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewInfo.Type}" Value="{x:Static models:PreviewType.None}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Image Source="{Binding PreviewInfo.IconPreview}"
                                   Width="64"
                                   Height="64"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />

                            <TextBlock Text="{Binding PreviewInfo.FileName}"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="{Binding PreviewInfo.FileSizeFormatted}"
                                       Foreground="Gray"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       Margin="0,0,0,4" />

                            <TextBlock Text="{Binding PreviewInfo.LastModifiedFormatted}"
                                       Foreground="Gray"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="{Binding PreviewInfo.StatusMessage}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Loading Indicator -->
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     VerticalAlignment="Top"
                                     Visibility="{Binding PreviewInfo.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <!-- Preview Footer / Details -->
                    <Border Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="8,6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{Binding PreviewInfo.FilePath, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
                        <TextBlock Text="{Binding PreviewInfo.FilePath}"
                                   Foreground="Gray"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PreviewInfo.FilePath}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
