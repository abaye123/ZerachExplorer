<w:DialogWindow x:Class="ZerachExplorer.MVVM.Views.Windows.ConflictResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:ZerachExplorer.MVVM.Views.Windows"
        Title="קובץ בשם זה כבר קיים ביעד"
        Width="560"
        Glyph="&#xE8C8;">
    <w:DialogWindow.Footer>
        <StackPanel Orientation="Horizontal">
            <Button Content="החלפה" Style="{StaticResource DialogButton}" Click="OnReplaceClick" />
            <Button Content="שמירת שניהם" Style="{StaticResource DialogAccentButton}" Click="OnKeepBothClick" />
            <Button Content="דילוג" Style="{StaticResource DialogButton}" Click="OnSkipClick" />
            <Button Content="ביטול" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </w:DialogWindow.Footer>
    <StackPanel>
        <TextBlock x:Name="TxtFileName" Style="{StaticResource NameText}" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Border Style="{StaticResource Card}" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="הקובץ שקיים ביעד" />
                <TextBlock x:Name="TxtExistingInfo" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="הקובץ החדש" />
                <TextBlock x:Name="TxtIncomingInfo" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
        <CheckBox x:Name="ChkApplyToAll" Content="לעשות כך בכל ההתנגשויות הבאות בהעברה זו" Margin="0,8,0,0" />
    </StackPanel>
</w:DialogWindow>
