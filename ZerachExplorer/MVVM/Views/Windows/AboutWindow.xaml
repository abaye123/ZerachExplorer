<w:DialogWindow x:Class="ZerachExplorer.MVVM.Views.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:ZerachExplorer.MVVM.Views.Windows"
        Title="אודות התוכנה"
        Width="520"
        Glyph="">
    <w:DialogWindow.Footer>
        <StackPanel Orientation="Horizontal">
            <Button Content="סגירה" Style="{StaticResource DialogAccentButton}" Click="Button_Click" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </w:DialogWindow.Footer>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="../../../Assets/app.ico" Width="56" Height="56" Style="{StaticResource SharpImage}" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="זרח אקספלורר" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="LblVersion" Style="{StaticResource Caption}" />
            </StackPanel>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" LineHeight="22" Text="סייר קבצים מודרני ומוגן עבור עמדות מחשבים ציבוריות. אין גישה לכונן C, לקבצים מוסתרים ולכונני אוצר החכמה, ונפתחים רק קבצים מהסוגים המאושרים." />
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16" />
        <TextBlock Text="קרדיט" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" LineHeight="22" Text="רוב החידושים בגרסה 2.0.0 פותחו על ידי המלאך (Amlaach). התוכנה מבוססת על הפרויקט LiteExplorer." />
        <TextBlock Text="קוד המקור, ברישיון BSD 3-Clause:" Margin="0,12,0,0" />
        <TextBlock FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="github.com/abaye123/ZerachExplorer" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="תמיכה:" Margin="0,12,0,0" />
        <TextBlock FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="cs@abaye.co  |  abaye.co" Foreground="{StaticResource AccentBrush}" />
    </StackPanel>
</w:DialogWindow>
