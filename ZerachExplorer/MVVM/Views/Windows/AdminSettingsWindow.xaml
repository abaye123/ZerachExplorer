<w:DialogWindow x:Class="ZerachExplorer.MVVM.Views.Windows.AdminSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:ZerachExplorer.MVVM.Views.Windows"
        Title="הגדרות מנהל"
        Width="820"
        Glyph="&#xE713;">
    <w:DialogWindow.Footer>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TxtStatusMessage" VerticalAlignment="Center" MaxWidth="420" TextWrapping="Wrap" Margin="0,0,16,0" Foreground="{StaticResource ErrorBrush}" />
            <Button Content="שמירה" Style="{StaticResource DialogAccentButton}" Click="Save_Click" />
            <Button Content="ביטול" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </w:DialogWindow.Footer>
    <TabControl Height="470" BorderThickness="0" Padding="0" Background="Transparent">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel IsItemsHost="True" Margin="0,0,20,0" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Back" Background="Transparent" CornerRadius="5" Margin="0,1" Height="40">
                                <DockPanel>
                                    <Border x:Name="Mark" Width="3" Height="16" CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="Hidden" />
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Glyph}" Margin="10,0,14,0" Foreground="{StaticResource AccentBrush}" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.ItemContainerStyle>
            <TabItem Header="פרופיל והרשאות" Tag="&#xE7EF;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="0,0,14,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="פרופיל העמדה" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="בחירת פרופיל קובעת את ההרשאות שלמטה. אפשר לשנות כל אחת מהן." Margin="0,2,0,10" />
                                <ComboBox x:Name="CmbProfile" SelectionChanged="CmbProfile_SelectionChanged">
                                    <ComboBoxItem Content="עמדת מסמכים רגילה (ברירת מחדל)" Tag="Standard" />
                                    <ComboBoxItem Content="קריאה בלבד" Tag="ReadOnly" />
                                    <ComboBoxItem Content="עמדה מבוקרת - רק כוננים ותיקיות מאושרים" Tag="Controlled" />
                                    <ComboBoxItem Content="התאמה אישית" Tag="Custom" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="הרשאות" FontWeight="SemiBold" Margin="2,12,0,8" />
                        <Border Style="{StaticResource Card}" Padding="18,4">
                            <StackPanel>
                            <CheckBox x:Name="ChkCanList" Content="עיון בתיקיות" Style="{StaticResource ToggleSwitch}" />
                            <CheckBox x:Name="ChkCanOpen" Content="פתיחת קבצים" Style="{StaticResource ToggleSwitch}" />
                            <CheckBox x:Name="ChkCanCopyFrom" Content="העתקת קבצים" Style="{StaticResource ToggleSwitch}" />
                            <CheckBox x:Name="ChkCanCopyTo" Content="הדבקת קבצים" Style="{StaticResource ToggleSwitch}" />
                            <CheckBox x:Name="ChkCanRename" Content="שינוי שם" Style="{StaticResource ToggleSwitch}" />
                            <CheckBox x:Name="ChkCanDelete" Content="מחיקה" Style="{StaticResource ToggleSwitch}" />
                            <CheckBox x:Name="ChkCanCreateDir" Content="יצירת תיקיות" Style="{StaticResource ToggleSwitch}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="קיוסק וכונני USB" Tag="&#xE7F4;">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="18,4">
                        <StackPanel>
                            <CheckBox x:Name="ChkKioskMode" Content="מצב קיוסק במסך מלא" Style="{StaticResource ToggleSwitch}" />
                            <CheckBox x:Name="ChkPreventExit" Content="יציאה מהתוכנה רק עם סיסמת מנהל" Style="{StaticResource ToggleSwitch}" />
                            <CheckBox x:Name="ChkUsbDialog" Content="הצעה לפתוח כונן USB כשהוא מתחבר" Style="{StaticResource ToggleSwitch}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="סוגי קבצים" Tag="&#xE8A5;">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="רק קבצים מהסוגים ברשימה ניתנים לפתיחה ולהעתקה." Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="הסר נבחר" Style="{StaticResource DialogButton}" Click="RemoveExtension_Click" />
                        <Button Content="ברירת מחדל" Style="{StaticResource DialogButton}" Click="ResetExtensions_Click" />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="הוסף" Style="{StaticResource DialogAccentButton}" Margin="8,0,0,0" Click="AddExtension_Click" />
                        <TextBox x:Name="TxtNewExtension" FlowDirection="LeftToRight" />
                    </DockPanel>
                    <ListBox x:Name="LstExtensions" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="תיקיות מאושרות" Tag="&#xE8B7;">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="תיקיות אלה מוצגות במסך הבית, ובעמדה מבוקרת רק הן נגישות." Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="הסר נבחר" Style="{StaticResource DialogButton}" Click="RemoveDirectory_Click" />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="הוסף" Style="{StaticResource DialogAccentButton}" Margin="8,0,0,0" Click="AddDirectory_Click" />
                        <TextBox x:Name="TxtNewDirectory" FlowDirection="LeftToRight" />
                    </DockPanel>
                    <ListBox x:Name="LstDirectories" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="כוננים" Tag="&#xEDA2;">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="סמן כוננים לחסימה. כונן המערכת וכונני אוצר החוכמה חסומים תמיד." Margin="0,0,0,12" />
                    <ListBox x:Name="LstDrives" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsBlocked, Mode=TwoWay}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="יומן" Tag="&#xE81C;">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="רישומים נמחקים כשהם ישנים ממספר הימים, או מוקדם יותר אם היומן הגיע לנפח המרבי." Margin="0,0,0,12" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBox x:Name="TxtLogDays" DockPanel.Dock="Right" Width="100" FlowDirection="LeftToRight" />
                            <TextBlock Text="מספר ימים לשמירה (1-365)" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBox x:Name="TxtLogSize" DockPanel.Dock="Right" Width="100" FlowDirection="LeftToRight" />
                            <TextBlock Text="נפח מרבי במגה-בייט (1-500)" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="סיסמת מנהל" Tag="&#xE72E;">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="סיסמה חדשה (לפחות 8 תווים)" Margin="0,0,0,6" />
                        <PasswordBox x:Name="TxtNewPassword" Margin="0,0,0,12" />
                        <TextBlock Text="אימות סיסמה" Margin="0,0,0,6" />
                        <PasswordBox x:Name="TxtConfirmPassword" Margin="0,0,0,14" />
                        <Button Content="עדכון סיסמה" Style="{StaticResource DialogButton}" HorizontalAlignment="Left" Click="UpdatePassword_Click" />
                        <TextBlock x:Name="TxtPasswordStatus" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="ייבוא וייצוא" Tag="&#xE8AB;">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ייצוא הגדרות" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="שומר את כל ההגדרות שמוצגות כאן לקובץ, להעברה למחשבים אחרים." Margin="0,2,0,4" />
                            <CheckBox x:Name="ChkExportPassword" Content="לכלול את סיסמת המנהל (מוצפנת)" Style="{StaticResource ToggleSwitch}" />
                            <Button Content="ייצוא לקובץ..." Style="{StaticResource DialogButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="Export_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ייבוא הגדרות" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="טוען הגדרות מקובץ אל המסך הזה. הן נכנסות לתוקף רק אחרי לחיצה על שמירה. אם אין בקובץ סיסמה, הסיסמה הנוכחית נשמרת." Margin="0,2,0,10" />
                            <Button Content="ייבוא מקובץ..." Style="{StaticResource DialogButton}" HorizontalAlignment="Left" Click="Import_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
    </TabControl>
</w:DialogWindow>
