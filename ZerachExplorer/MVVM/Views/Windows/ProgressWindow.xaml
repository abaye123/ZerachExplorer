<w:DialogWindow x:Class="ZerachExplorer.MVVM.Views.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZerachExplorer.MVVM.ViewModels"
        xmlns:w="clr-namespace:ZerachExplorer.MVVM.Views.Windows"
        Title="פעולות בקבצים"
        Width="492"
        MaxHeight="640"
        ShowActivated="False"
        Glyph="&#xE8B7;">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl ItemsSource="{Binding Visible}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <DockPanel Margin="0,4,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}">
                                <Button Command="{Binding PauseCmd}" Width="36">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Content" Value="&#xE769;" />
                                            <Setter Property="ToolTip" Value="השהיה" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Content" Value="&#xE768;" />
                                                    <Setter Property="ToolTip" Value="המשך" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="36" Command="{Binding CancelCmd}" ToolTip="ביטול" />
                            </StackPanel>
                            <TextBlock Text="{Binding PercentText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Speed graph, only when there are bytes to measure -->
                        <Border Background="#F3F8F3"
                                BorderBrush="#CFE3CF"
                                BorderThickness="1"
                                Height="66"
                                ClipToBounds="True"
                                Visibility="{Binding HasBytes, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Border HorizontalAlignment="Left" Background="#DDF0DD">
                                    <Border.Width>
                                        <MultiBinding Converter="{x:Static w:ProgressWindow.FractionWidth}">
                                            <Binding Path="Fraction" />
                                            <Binding Source="{x:Static vm:FileOperation.GraphWidth}" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                <Canvas Width="440" Height="64" HorizontalAlignment="Left">
                                    <Polygon Points="{Binding Graph}" Fill="#8FCB8F" Stroke="#0F9D0F" StrokeThickness="1" />
                                </Canvas>
                                <TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,4" FontSize="12.5" />
                            </Grid>
                        </Border>

                        <ProgressBar Height="6"
                                     Value="{Binding Percent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding HasBytes, Converter={StaticResource InverseBoolToVisibility}}" />

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock Text="שם:" Width="110" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding CurrentName}" Style="{StaticResource NameText}" FontSize="13" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0" Visibility="{Binding HasBytes, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="זמן שנותר:" Width="110" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding RemainingTimeText}" FontSize="13" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="פריטים שנותרו:" Width="110" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding RemainingItemsText}" FontSize="13" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</w:DialogWindow>
