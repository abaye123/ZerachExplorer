    <FileVersion>1.7.0.0</FileVersion>
    <Company>ZerachExplorer</Company>
    <Product>ZerachExplorer</Product>
    <Copyright>Copyright © 2026 ZerachExplorer Contributors</Copyright>
  </PropertyGroup>
</Project>
